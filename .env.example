# ---------------------------------------------------------------------------
# AI 大模型配置（复制本文件为 .env 后填写真实值；.env 不要提交到版本库）
# ---------------------------------------------------------------------------

# API 密钥。任何兼容 OpenAI Chat Completions 协议的服务均可。
# 支持的变量名：AI_API_KEY 或 OPENAI_API_KEY
AI_API_KEY=
# OPENAI_API_KEY=

# 服务地址（默认 OpenAI 官方；使用其他服务商时填写其兼容端点）
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot: https://api.moonshot.cn/v1
# 本地 vLLM/Ollama: http://localhost:8000/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称（由服务商决定，例如 gpt-4o-mini / deepseek-chat / moonshot-v1-8k）
AI_MODEL=gpt-4o-mini

# 单次请求超时（秒）
AI_TIMEOUT=60

# 失败后的额外重试次数（仅对超时/限流/网络错误生效；0 表示不重试）
AI_MAX_RETRIES=2

# 采样温度与最大输出 token（报告字段较多，建议不低于 4000）
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=8000

# 是否要求服务端返回严格 JSON。若服务商不支持会自动降级为普通文本模式。
AI_JSON_MODE=true

# 重试退避基准时间（秒），实际等待为 retry_backoff * 2^(attempt-1)
AI_RETRY_BACKOFF=2

# ---------------------------------------------------------------------------
# 行情与输出配置（可选，均有默认值）
# ---------------------------------------------------------------------------

# 分析用日线抓取范围（yfinance period 语法：1y / 2y / 5y ...）
ANALYSIS_PERIOD=2y

# 计算 MA200 与 6 个月收益率所需的最少日线数量（不足会在报告中提示）
MIN_DAILY_BARS=260

# 相对强弱对比基准（逗号分隔；留空则不做相对强弱）
BENCHMARKS=SPY,QQQ

# 输出目录
KLINE_DIR=kline_data
REPORTS_DIR=reports

# 数据时区（仅用于记录与展示）
MARKET_TIMEZONE=America/New_York
